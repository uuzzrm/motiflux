{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/uuzzrm/motiflux/schemas/themes.schema.json",
  "title": "Motiflux motion theme catalog",
  "type": "object",
  "required": ["schema_version", "catalog_id", "themes"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "catalog_id": { "const": "motiflux-motion-themes" },
    "source_policy": { "type": "string", "minLength": 1 },
    "themes": {
      "type": "array",
      "minItems": 13,
      "items": {
        "type": "object",
        "required": ["id", "name", "aliases", "design_intent", "algorithm_stack", "controls", "exclusions", "qa_focus", "runtime"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "name": { "type": "string", "minLength": 1 },
          "aliases": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "public_analogue": { "type": "string" },
          "design_intent": { "type": "string", "minLength": 1 },
          "algorithm_stack": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "implementation": { "type": "array", "items": { "type": "string" } },
          "controls": { "type": "array", "items": { "type": "string" } },
          "exclusions": { "type": "array", "items": { "type": "string" } },
          "qa_focus": { "type": "array", "items": { "type": "string" } },
          "runtime": {
            "type": "object",
            "required": ["tempo", "settle_damping", "secondary_effect"],
            "properties": {
              "tempo": { "type": "number", "exclusiveMinimum": 0 },
              "settle_damping": { "type": "number", "minimum": 0, "maximum": 1 },
              "secondary_effect": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
