{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/uuzzrm/motiflux/schemas/motion-plan.schema.json",
  "title": "Motiflux motion plan",
  "type": "object",
  "required": ["schema_version", "project", "theme_selection", "motion_language", "foreground_plan", "beats", "runtime"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "project": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "surface": { "type": "string" },
        "source": { "type": "string" }
      },
      "additionalProperties": true
    },
    "theme_selection": {
      "type": "object",
      "required": ["primary", "primary_id", "modifiers", "matched_tags", "rejected_candidates"],
      "properties": {
        "primary": { "type": "string", "minLength": 1 },
        "primary_id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "modifiers": { "type": "array", "maxItems": 2, "items": { "type": "string" } },
        "matched_tags": { "type": "array", "items": { "type": "string" } },
        "rejected_candidates": { "type": "array", "items": { "type": "string" } },
        "public_reference_basis": { "type": "array", "items": { "type": "string" } },
        "algorithm_stack": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    },
    "motion_language": {
      "type": "object",
      "required": ["traits"],
      "properties": {
        "traits": { "type": "array", "minItems": 1, "items": { "type": "object" } }
      },
      "additionalProperties": true
    },
    "constraints": { "type": "array", "items": { "type": "object" } },
    "foreground_plan": {
      "type": "object",
      "required": ["source_actors", "stage_order", "stages", "proof", "static_canonical_fallback", "actor_stage_map"],
      "properties": {
        "source_actors": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "actor_stage_map": { "type": "object", "additionalProperties": { "type": "string" } },
        "role_annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["role", "basis", "confidence", "review_status", "accepted_role"],
            "properties": {
              "role": { "enum": ["origin-dot", "arc", "bar", "monogram", "wordmark", "unknown"] },
              "basis": { "type": "string", "minLength": 1 },
              "confidence": { "enum": ["low", "medium", "high"] },
              "review_status": { "enum": ["accepted", "needs-review", "observed"] },
              "accepted_role": { "type": ["string", "null"] }
            },
            "additionalProperties": true
          }
        },
        "layout_groups": { "type": "object", "additionalProperties": { "type": "array", "items": { "type": "string" } } },
        "mapping_policy": { "type": "string", "minLength": 1 },
        "stage_order": { "type": "array", "minItems": 5, "items": { "type": "string", "minLength": 1 } },
        "stages": {
          "type": "array",
          "minItems": 5,
          "items": {
            "type": "object",
            "required": ["id", "source_actors", "path_strategy", "speed_profile", "visible_proof", "role_bindings"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
              "source_actors": { "type": "array", "items": { "type": "string", "minLength": 1 } },
              "path_strategy": { "type": "string", "minLength": 1 },
              "speed_profile": {
                "type": "object",
                "required": ["tempo", "settle_damping", "phase"],
                "properties": {
                  "tempo": { "type": "number", "exclusiveMinimum": 0 },
                  "settle_damping": { "type": "number", "minimum": 0 },
                  "phase": { "type": "string", "minLength": 1 }
                },
                "additionalProperties": true
              },
              "visible_proof": {
                "type": "object",
                "required": ["criterion", "source_actor_count"],
                "properties": {
                  "criterion": { "type": "string", "minLength": 1 },
                  "source_actor_count": { "type": "integer", "minimum": 0 }
                },
                "additionalProperties": true
              },
              "role_bindings": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["actor_id", "role", "confidence", "review_status", "accepted_role", "evidence"],
                  "properties": {
                    "actor_id": { "type": "string", "minLength": 1 },
                    "role": { "enum": ["origin-dot", "arc", "bar", "monogram", "wordmark", "unknown"] },
                    "confidence": { "enum": ["low", "medium", "high"] },
                    "review_status": { "enum": ["accepted", "needs-review", "observed"] },
                    "accepted_role": { "type": ["string", "null"] },
                    "evidence": { "type": "string", "minLength": 1 }
                  },
                  "additionalProperties": true
                }
              }
            },
            "additionalProperties": true
          }
        },
        "proof": {
          "type": "object",
          "required": ["trajectory_id", "identity_rule", "canonical_rule"],
          "properties": {
            "trajectory_id": { "type": "string", "minLength": 1 },
            "identity_rule": { "type": "string", "minLength": 1 },
            "canonical_rule": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": true
        },
        "static_canonical_fallback": {
          "type": "object",
          "required": ["mode", "source_actors", "trigger"],
          "properties": {
            "mode": { "const": "static-canonical" },
            "source_actors": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
            "trigger": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "actors": { "type": "array", "items": { "type": "object" } },
    "beats": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "intent"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "intent": { "type": "string", "minLength": 1 },
          "duration_weight": { "type": "number", "exclusiveMinimum": 0 }
        },
        "additionalProperties": true
      }
    },
    "dependencies": { "type": "array", "items": { "type": "object" } },
    "runtime": {
      "type": "object",
      "required": ["duration_ms", "reduced_motion"],
      "properties": {
        "duration_ms": { "type": "integer", "minimum": 1 },
        "reduced_motion": { "enum": ["static-canonical", "opacity-only", "user-choice"] },
        "seed": { "type": ["integer", "null"] },
        "tempo": { "type": "number", "exclusiveMinimum": 0 },
        "direction": { "enum": ["left-to-right", "right-to-left", "top-to-bottom", "bottom-to-top", "radial"] },
        "direction_vector": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "integer", "minimum": -1, "maximum": 1 } },
        "particles": { "type": "boolean" },
        "particle_density": { "enum": ["sparse", "standard", "dense"] },
        "background": {
          "type": "object",
          "required": ["mode", "color", "source"],
          "properties": {
            "mode": { "enum": ["theme", "solid", "transparent"] },
            "color": { "type": ["string", "null"] },
            "source": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": true
        },
        "requested_formats": { "type": "array", "minItems": 1, "items": { "enum": ["gif", "html", "svg", "pdf"] } },
        "controls": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
